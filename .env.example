# X API credentials (OAuth 1.0a user context) for the account whose bookmarks you list.
# Get them at https://developer.x.com > your app > Keys and tokens.
# App permissions: Read. Do not use the Bearer Token; it cannot read bookmarks.
#
# Local: copy to .env (gitignored) and fill in.
# CI: add each as a GitHub Actions repository secret with the same name.

# Consumer key ("API Key")
X_API_KEY=
# Consumer secret ("API Key Secret")
X_API_SECRET=
# Access Token for your account (format: <digits>-<chars>)
X_ACCESS_TOKEN=
# Access Token Secret
X_ACCESS_TOKEN_SECRET=
